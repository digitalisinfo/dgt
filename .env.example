# ActiveCampaign — Settings → Developer → API Access
# Copie este arquivo para .env e preencha os valores.

ACTIVECAMPAIGN_API_URL=https://SUA_CONTA.api-us1.com
ACTIVECAMPAIGN_API_KEY=

# Área interna (/login) — protege /audio, /video e /criativos
TOOLS_USER=admin
TOOLS_PASSWORD=troque-esta-senha
AUTH_SECRET=cole-aqui-uma-string-longa-aleatoria

# Replicate — https://replicate.com/account/api-tokens
# Usado pelo gerador de criativos (Seedance 2.5)
REPLICATE_API_TOKEN=
